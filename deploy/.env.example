# Copiar como .env en la misma carpeta y rellenar. NUNCA subir el .env a GitHub.

# Contraseña de la base de datos (inventa una larga)
POSTGRES_PASSWORD=CAMBIAR

# Cadena secreta de Payload: generar con  openssl rand -hex 32
PAYLOAD_SECRET=CAMBIAR

# Dirección pública
SITE_URL=https://mystina.blog

# Primer usuario del panel (se crea solo al primer arranque).
# Después de entrar por primera vez, se pueden borrar estas dos líneas.
ADMIN_EMAIL=CAMBIAR
ADMIN_PASSWORD=CAMBIAR

# Puerto local en el servidor (cambiar si el 3010 ya está ocupado)
PUERTO_WEB=3010
